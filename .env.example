# Copy to .env for local development. All values are optional.

# Port the server listens on.
PORT=3000

# error, warn, log (default) or debug. Logs go to the console and DATA_DIR/logs/jobify.log.
# LOG_LEVEL=debug

# Where the SQLite database is stored. Defaults to apps/server/data.
# DATA_DIR=./data

# Only for instances upgraded from versions before user accounts: the old password,
# which must be entered to create the first admin account.
# JOBIFY_PASSWORD=

# Default AI provider settings. Settings saved in the UI take precedence.
# One of: anthropic, openai, gemini, ollama, openai_compatible
# AI_PROVIDER=
# AI_MODEL=
# AI_API_KEY=
# AI_BASE_URL=
