# Copy to .env for local development. All values are optional.

# Port the server listens on.
PORT=3000

# Where the SQLite database is stored. Defaults to apps/server/data.
# DATA_DIR=./data

# Require a password to use Jobify.
# JOBIFY_PASSWORD=

# Default AI provider settings. Settings saved in the UI take precedence.
# One of: anthropic, openai, gemini, ollama, openai_compatible
# AI_PROVIDER=
# AI_MODEL=
# AI_API_KEY=
# AI_BASE_URL=
